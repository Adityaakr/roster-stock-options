# The web app for a host that runs containers (Railway, Fly). Vercel needs no Dockerfile; point it at apps/web.
# NEXT_PUBLIC_* values are baked in at build time, so they must be present as build variables, not only at runtime.
FROM node:22-slim
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/web ./apps/web
COPY fixtures ./fixtures
# The e2e specs are in the web tsconfig and import from scripts/, so the type check needs them.
COPY scripts ./scripts
COPY tsconfig.base.json tsconfig.json ./
RUN pnpm install --frozen-lockfile --ignore-scripts
ARG NEXT_PUBLIC_CLUSTER=devnet
ENV NEXT_PUBLIC_CLUSTER=$NEXT_PUBLIC_CLUSTER
ARG NEXT_PUBLIC_PRIVY_APP_ID
ENV NEXT_PUBLIC_PRIVY_APP_ID=$NEXT_PUBLIC_PRIVY_APP_ID
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @roster/web build
EXPOSE 3000
# Next reads PORT; Railway sets it.
CMD ["sh", "-c", "cd apps/web && pnpm exec next start -p ${PORT:-3000} -H 0.0.0.0"]
