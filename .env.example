# Copy to .env (git-ignored). See docs/OPERATOR.md for what each blocks.
PYTH_CORE_API_KEY=
PYTH_PRO_API_KEY=
TOKENS_XYZ_API_KEY=
# The intent box on Markets (docs/INTENT.md). Server-side only; the box is absent from the app when empty.
OPENROUTER_API_KEY=
HELIUS_API_KEY=
# Optional explicit upstream for the surfpool fork; public mainnet RPC is used when empty.
FORK_DATASOURCE_URL=
FORK_PORT=8899
FORK_WS_PORT=8900
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_CLUSTER=fork
# 1 offers a throwaway burner wallet on the fork and devnet for the browser journeys; leave unset on a public deployment.
NEXT_PUBLIC_BURNER_WALLET=1
# The app's own RPC and the services process it reads (apps/web reads the root .env through next.config.ts).
RPC_URL=http://127.0.0.1:8899
SERVICES_URL=http://127.0.0.1:8787
# Comma-separated ISO country codes the app refuses to serve; the request's country comes from the edge (x-vercel-ip-country, cf-ipcountry).
GEO_BLOCKED_COUNTRIES=US
JUPITER_API_KEY=
DATABASE_URL=
SENTRY_DSN=
DEPLOYER_KEYPAIR=
KEEPER_KEYPAIR=
QUOTER_KEYPAIR=
MULTISIG=
