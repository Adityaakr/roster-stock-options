# The services: quoter, keeper, indexer and the REST the app reads. One always-on process, which is why it does not
# live on the same host as the web app: a serverless function cannot hold a tick loop or a SQLite file.
FROM node:22-slim
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages ./packages
COPY scripts ./scripts
COPY fixtures ./fixtures
COPY tsconfig.base.json tsconfig.json ./
RUN pnpm install --frozen-lockfile --ignore-scripts
# The indexer's store is a file; a host that restarts with an empty disk rebuilds it from the chain's own events.
ENV INDEXER_DB=/data/indexer.sqlite
# The store lives on a volume the host mounts at /data (Railway: Volumes, mount path /data).
EXPOSE 8787
CMD ["pnpm", "tsx", "packages/services/src/main.ts"]
